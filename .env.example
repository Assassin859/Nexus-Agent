# =============================================================================
# NexusAgent — Environment Variables
# Copy this file to .env and fill in each value before running any service.
# NEVER commit .env to git. .env.example is safe to commit.
# =============================================================================


# -----------------------------------------------------------------------------
# OPENROUTER API (Primary Free Brain)
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
BRAIN_MODEL=google/gemini-2.0-flash-exp:free

# GOOGLE GEMINI API (Fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback models (only used if GEMINI_API_KEY is unset)
OPENAI_BRAIN_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# GITHUB MODELS API
# Used by: nexus-agent/src/brain/provider.ts
# Powers: All AI decision calls (Guardian, Yield, DCA, PayChain modules)
# How to get: github.com -> Settings -> Developer Settings ->
#             Personal Access Tokens -> Tokens (classic) -> Generate new token
#             No special scopes needed for model inference. Just generate it.
# Format: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# -----------------------------------------------------------------------------
GITHUB_TOKEN=


# -----------------------------------------------------------------------------
# POSTGRES DATABASE (Railway)
# Used by: nexus-agent/src/db/client.ts
# Powers: All stateful memory (workflows, cycles, execution logs)
# How to get: railway.app -> New Project -> Add PostgreSQL ->
#             Click the Postgres service -> Connect tab ->
#             Copy the "Postgres Connection URL"
# Format: postgresql://postgres:PASSWORD@HOST:PORT/railway
# Note: On Railway free tier this is always available, no credit card needed
# -----------------------------------------------------------------------------
DATABASE_URL=


# -----------------------------------------------------------------------------
# KEEPERHUB API KEY
# Used by: nexus-agent/src/lib/mcp-client.ts
# Powers: Creating and executing on-chain workflows via KeeperHub MCP
# How to get: app.keeperhub.com -> Settings -> API Keys -> Create key
#             Choose "Organization Key" (kh_ prefix)
# Format: kh_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Warning: This is NOT the same as the wfb_ webhook trigger key
# -----------------------------------------------------------------------------
KEEPERHUB_API_KEY=


# -----------------------------------------------------------------------------
# KEEPERHUB MCP SERVER URL
# Used by: nexus-agent/src/lib/mcp-client.ts
# This is the MCP endpoint — unlikely to change, leave as-is
# -----------------------------------------------------------------------------
KEEPERHUB_MCP_URL=https://mcp.keeperhub.com


# -----------------------------------------------------------------------------
# AGENTIC WALLET ADDRESS (Turnkey / Para MPC wallet)
# Used by: nexus-agent/src/lib/simulate.ts + all modules (tx sender)
# Powers: The wallet that signs and broadcasts all on-chain transactions
# This is NOT your MetaMask. It is the KeeperHub non-custodial MPC wallet.
# How to get: In KeeperHub dashboard -> Wallet -> Create Agentic Wallet
#             OR via CLI: kh wallet create
#             Copy the generated 0x address shown after creation
# Format: 0xYourAgenticWalletAddress (42 chars)
# Note: Fund this with Sepolia ETH for gas before July 27
# -----------------------------------------------------------------------------
AGENTIC_WALLET_ADDRESS=


# -----------------------------------------------------------------------------
# ALCHEMY RPC URL (Primary Base Sepolia RPC)
# Used by: nexus-agent/src/lib/rpc.ts
# Powers: Reading Aave health factors, wallet balances, gas estimates
# How to get: dashboard.alchemy.com -> Create App ->
#             Network: Base Sepolia -> Copy the HTTPS URL
# Format: https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# Note: Free tier gives 300M compute units/month — more than enough
# -----------------------------------------------------------------------------
ALCHEMY_RPC_URL=


# -----------------------------------------------------------------------------
# INFURA RPC URL (Fallback Base Sepolia RPC)
# Used by: nexus-agent/src/lib/rpc.ts (fallback if Alchemy fails)
# How to get: app.infura.io -> Create New API Key ->
#             Network: Sepolia -> Copy the endpoint URL
# Format: https://sepolia.infura.io/v3/YOUR_PROJECT_ID
# Note: Free tier is 100k requests/day — fine as a backup
# -----------------------------------------------------------------------------
INFURA_RPC_URL=


# -----------------------------------------------------------------------------
# JWT AUTHENTICATION & SECURITY
# Used by: nexus-agent/src/middleware/auth.ts
# JWT_SECRET is REQUIRED in production (NODE_ENV=production)
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# AGENT SERVER PORT
# Used by: nexus-agent/src/index.ts
# Railway will override this automatically with its own PORT variable
# For local dev: 3001 is the default (dashboard expects this)
# -----------------------------------------------------------------------------
PORT=3001


# =============================================================================
# DASHBOARD (nexus-dashboard) — prefix all with NEXT_PUBLIC_ to expose to
# the browser. Never put secrets here.
# =============================================================================


# -----------------------------------------------------------------------------
# AGENT API BASE URL
# Used by: nexus-dashboard (all fetch calls to the backend)
# Local dev: http://localhost:3001
# Production: your Railway nexus-agent public URL
# Format: https://nexus-agent-production-xxxx.up.railway.app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AGENT_URL=http://localhost:3001


# -----------------------------------------------------------------------------
# YOUR METAMASK WALLET ADDRESS (Monitored wallet — NOT the agentic wallet)
# Used by: nexus-dashboard (displays portfolio data for this wallet)
# This is your own MetaMask wallet on Sepolia that HAS an open Aave V3 loan
# The agent watches this wallet's health factor but does NOT need to own it
# How to get: Open MetaMask -> switch to Sepolia -> copy your 0x address
# Format: 0xYourMetaMaskWalletAddress (42 chars)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WALLET_ADDRESS=

# =============================================================================
# PHASE 5 — PRODUCTION HARDENING
# =============================================================================

# -----------------------------------------------------------------------------
# ETH PRICE FALLBACK
# Used by: nexus-agent/src/lib/price-feed.ts
# Live price is fetched from Chainlink Sepolia aggregator. This fallback is
# used when Chainlink is unavailable or returns a stale round (> 1 hour old).
# -----------------------------------------------------------------------------
ETH_PRICE_USD_FALLBACK=3000

# -----------------------------------------------------------------------------
# COMPOUND APY FALLBACK
# Used by: nexus-agent/src/modules/yield-rotator.ts
# Conservative fallback when the Compound on-chain APY fetch fails.
# 3% avoids phantom rotations that would fire at the old hardcoded 32.59%.
# -----------------------------------------------------------------------------
COMPOUND_APY_FALLBACK=3

# -----------------------------------------------------------------------------
# ESTIMATED GAS USD FALLBACK
# Used by: nexus-agent/src/modules/yield-rotator.ts
# Fallback gas cost estimate (USD) when RPC fee data fetch fails.
# -----------------------------------------------------------------------------
ESTIMATED_GAS_USD_FALLBACK=4.5

# -----------------------------------------------------------------------------
# KEEPERHUB ALERT CHANNEL
# Used by: nexus-agent/src/modules/guardian.ts, yield-rotator.ts, index.ts
# Options: telegram | discord | email
# Alerts are sent via the KeeperHub sendKeeperNotification MCP surface.
# Silently no-ops in dev when MCP is unavailable.
# -----------------------------------------------------------------------------
ALERT_CHANNEL=telegram

# -----------------------------------------------------------------------------
# ALERT COOLDOWN (minutes)
# Prevents alert storms during sustained RPC outages or cron failures.
# One alert per wallet per event type per cooldown window.
# Set to a very large number (e.g. 10080) to effectively disable alerts.
# -----------------------------------------------------------------------------
ALERT_COOLDOWN_MINUTES=10

# -----------------------------------------------------------------------------
# LOG LEVEL
# Used by: nexus-agent/src/lib/logger.ts (pino)
# Options: trace | debug | info | warn | error | fatal
# In production, logs are emitted as NDJSON for log aggregators.
# In dev, pino-pretty colorizes output automatically.
# -----------------------------------------------------------------------------
LOG_LEVEL=info
